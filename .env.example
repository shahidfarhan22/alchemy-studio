# Copy this file to .env and fill in real values. Never commit .env itself.

# --- Database (PostgreSQL) ---
# Local dev: native PostgreSQL 17 running on this machine (see docs/decisions.md ADR-008).
# Dedicated role/database created for this project — do not reuse the postgres superuser.
DB_HOST=localhost
DB_PORT=5432
DB_NAME=alchemy_studio
DB_USER=alchemy_app
DB_PASSWORD=

# --- Backend (ASP.NET Core) ---
# JWT signing key for access tokens. Generate a long random value; never reuse across environments.
JWT_SIGNING_KEY=

# --- Razorpay (added at M4) ---
# RAZORPAY_KEY_ID=
# RAZORPAY_KEY_SECRET=
# RAZORPAY_WEBHOOK_SECRET=

# --- Email provider (added at M7) ---
# EMAIL_API_KEY=

# --- Object storage (added at M2) ---
# STORAGE_ACCESS_KEY=
# STORAGE_SECRET_KEY=
