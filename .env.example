# This file documents every secret/config value the project needs, for reference.
# Neither app actually reads a root .env file — see the notes under each section
# for where each one really lives locally.

# --- Database (PostgreSQL) ---
# Local dev: native PostgreSQL 17 (see docs/decisions.md ADR-008), dedicated
# role/database — never the postgres superuser. NOT read from .env: set locally via
#   dotnet user-secrets set "ConnectionStrings:Default" "Host=localhost;Port=5432;Database=alchemy_studio;Username=alchemy_app;Password=YOUR_PASSWORD"
# (see AGENTS.md). In staging/production this becomes a ConnectionStrings__Default
# environment variable set in the hosting platform's secret store.

# --- Backend (ASP.NET Core) ---
# JWT signing key for access tokens. Generate a long random value; never reuse across
# environments. Set the same way as the DB connection string, once auth is built (M1):
#   dotnet user-secrets set "Jwt:SigningKey" "..."

# --- Frontend (Next.js) ---
# Base URL the frontend calls for the API. Real file: frontend/.env.local (gitignored).
# NEXT_PUBLIC_API_URL=http://localhost:5007

# --- Razorpay (added at M4) ---
# RAZORPAY_KEY_ID=
# RAZORPAY_KEY_SECRET=
# RAZORPAY_WEBHOOK_SECRET=

# --- Email provider (added at M7) ---
# EMAIL_API_KEY=

# --- Object storage (added at M2) ---
# STORAGE_ACCESS_KEY=
# STORAGE_SECRET_KEY=
